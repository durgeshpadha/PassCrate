<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PassCrate.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>$(PassCrateProductName)</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.passcrate.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">33.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="PassCrate.GoogleClientId" Value="$(PassCrateGoogleClientId)" />
		<AssemblyMetadata Include="PassCrate.GoogleRedirectUri" Value="$(PassCrateGoogleRedirectUri)" Condition="'$(PassCrateGoogleRedirectUri)' != ''" />
		<AssemblyMetadata Include="PassCrate.DropboxAppKey" Value="$(PassCrateDropboxAppKey)" />
		<AssemblyMetadata Include="PassCrate.DropboxRedirectUri" Value="$(PassCrateDropboxRedirectUri)" Condition="'$(PassCrateDropboxRedirectUri)' != ''" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1120" BaseSize="128,128" />

		<!-- In-app brand imagery -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="121.6.0.1" />
		<!-- Align the Google binding's KTX dependencies with MAUI 10's AndroidX
		     runtime packages. These explicit pins eliminate out-of-range restores. -->
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.3" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="AdamE.Google.iOS.SignIn" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(PassCrateGoogleReversedClientId)' != ''">
		<CollectAppManifestsDependsOn>_GeneratePassCrateGoogleManifest;$(CollectAppManifestsDependsOn)</CollectAppManifestsDependsOn>
	</PropertyGroup>

	<Target Name="_GeneratePassCrateGoogleManifest"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(PassCrateGoogleReversedClientId)' != ''">
		<ItemGroup>
			<_PassCrateGooglePlistLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;" />
			<_PassCrateGooglePlistLine Include="&lt;plist version=&quot;1.0&quot;&gt;&lt;dict&gt;" />
			<_PassCrateGooglePlistLine Include="&lt;key&gt;CFBundleURLTypes&lt;/key&gt;&lt;array&gt;" />
			<_PassCrateGooglePlistLine Include="&lt;dict&gt;&lt;key&gt;CFBundleURLName&lt;/key&gt;&lt;string&gt;PassCrate OAuth&lt;/string&gt;&lt;key&gt;CFBundleURLSchemes&lt;/key&gt;&lt;array&gt;&lt;string&gt;passcrate&lt;/string&gt;&lt;string&gt;$(PassCrateGoogleReversedClientId)&lt;/string&gt;&lt;/array&gt;&lt;/dict&gt;" />
			<_PassCrateGooglePlistLine Include="&lt;/array&gt;&lt;/dict&gt;&lt;/plist&gt;" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)passcrate-google-oauth.plist" Lines="@(_PassCrateGooglePlistLine)" Overwrite="true" />
		<ItemGroup>
			<PartialAppManifest Include="$(IntermediateOutputPath)passcrate-google-oauth.plist" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <ProjectReference Include="..\PassCrate.Core\PassCrate.Core.csproj" />
	  <ProjectReference Include="..\PassCrate.Infrastructure\PassCrate.Infrastructure.csproj" />
	</ItemGroup>

</Project>
