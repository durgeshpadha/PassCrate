<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.CloudRestorePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Restore from Cloud">
    <ScrollView><VerticalStackLayout Padding="24,20,24,40" Spacing="14" MaximumWidthRequest="680" HorizontalOptions="Center">
        <Label Text="NEW DEVICE" Style="{StaticResource Eyebrow}" /><Label Text="Restore from Cloud" Style="{StaticResource PageTitle}" /><Label Text="Your provider stores only encrypted snapshots. Your vault passphrase unlocks them." Style="{StaticResource Muted}" />
        <Label Text="1 · Find your vault" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" /><Border Style="{StaticResource FieldBorder}"><Picker ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}" /></Border><Button Text="Authorize and find vaults" Command="{Binding FindVaultsCommand}" Style="{StaticResource SecondaryButton}" /><Label Text="{Binding DiscoveryStatus}" Style="{StaticResource Muted}" /><Border Style="{StaticResource FieldBorder}"><Picker ItemsSource="{Binding AvailableVaults}" SelectedItem="{Binding SelectedVault}" ItemDisplayBinding="{Binding DisplayName}" Title="Select vault" /></Border>
        <Label Text="2 · Unlock your vault" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" /><Label Text="Enter the same vault passphrase you use on your other device." Style="{StaticResource Muted}" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding VaultPassphrase}" Placeholder="Vault passphrase" IsPassword="True" /></Border>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" /><Button Text="Restore encrypted vault" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsNotBusy}" /><Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
