<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.CloudRestorePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="Restore from cloud">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" MaximumWidthRequest="640">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                    <Label Text="☁" Style="{StaticResource AccentIcon}" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="NEW DEVICE" Style="{StaticResource AccentEyebrow}" />
                    <Label Text="Restore your vault" Style="{StaticResource PageTitle}" FontSize="27" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Your cloud service stores only an encrypted backup. Use the same passphrase you used on your other device."
                   Style="{StaticResource PageLead}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 11">
                            <Label Text="1" Style="{StaticResource AccentIcon}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Find your cloud backup" FontFamily="OpenSansSemibold" FontSize="17" />
                            <Label Text="Connect the Google Drive or Dropbox account used on your other device." Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Card}"
                                Padding="12"
                                MinimumHeightRequest="58"
                                SemanticProperties.Description="Google Drive cloud service">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsGoogleDriveSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectProviderCommand}" CommandParameter="Google Drive" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="Google Drive" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="✓" TextColor="{StaticResource Primary}" IsVisible="{Binding IsGoogleDriveSelected}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Padding="12"
                                MinimumHeightRequest="58"
                                SemanticProperties.Description="Dropbox cloud service">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDropboxSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectProviderCommand}" CommandParameter="Dropbox" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="Dropbox" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="✓" TextColor="{StaticResource Primary}" IsVisible="{Binding IsDropboxSelected}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Label Text="After choosing a cloud service, tap the button below to search that account."
                           Style="{StaticResource Muted}" />
                    <Button Text="Connect and find backups  →"
                            Command="{Binding FindVaultsCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Label Text="{Binding DiscoveryStatus}"
                           Style="{StaticResource Muted}"
                           IsVisible="{Binding HasNotSearched}" />
                    <Border Style="{StaticResource DangerCard}" IsVisible="{Binding HasNoBackups}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="!" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" FontSize="20" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="No backups found" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding DiscoveryStatus}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SuccessCard}" IsVisible="{Binding HasAvailableVaults}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="✓" TextColor="{StaticResource Success}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1"
                                   Text="Backups found. The most recent backup is recommended."
                                   TextColor="{StaticResource Success}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasAvailableVaults}"
                                         BindableLayout.ItemsSource="{Binding AvailableVaults}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="14"
                                        MinimumHeightRequest="82"
                                        AutomationProperties.IsInAccessibleTree="True"
                                        SemanticProperties.Description="{Binding AccessibilityDescription}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectVaultCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="8">
                                        <Label Text="{Binding Title}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16" />
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding IsRecommended}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,3"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LightInfoSurface}, Dark={StaticResource DarkInfoSurface}}">
                                            <Label Text="RECOMMENDED"
                                                   Style="{StaticResource AccentEyebrow}"
                                                   FontSize="10" />
                                        </Border>
                                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="7">
                                            <Label Text="{Binding UpdatedText}" Style="{StaticResource Muted}" />
                                            <Label Text="·" Style="{StaticResource Muted}" />
                                            <Label Text="{Binding ProviderName}" Style="{StaticResource Muted}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Border Style="{StaticResource InfoCard}" IsVisible="{Binding HasAvailableVaults}">
                        <Label Text="PassCrate automatically restores the newest valid saved state inside the backup you select. You do not need to choose a technical version."
                               Style="{StaticResource Muted}" />
                    </Border>
                    <Border Style="{StaticResource DangerCard}" IsVisible="{Binding IsVaultSelectionInvalid}">
                        <Label Text="Choose a backup to continue."
                               Style="{StaticResource ErrorText}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasAvailableVaults}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 11">
                            <Label Text="2" Style="{StaticResource AccentIcon}" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Enter your backup passphrase" FontFamily="OpenSansSemibold" FontSize="17" />
                            <Label Text="This must match the passphrase used when the backup was created." Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsVaultPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding VaultPassphrase}" Placeholder="Vault passphrase" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button Text="Restore my vault"
                    Command="{Binding RestoreCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding HasAvailableVaults}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource TertiaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
