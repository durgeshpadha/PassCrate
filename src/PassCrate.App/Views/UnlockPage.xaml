<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.UnlockPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False" BackgroundColor="#0B1120">
    <Grid Padding="28" RowDefinitions="Auto,*,Auto"><HorizontalStackLayout Spacing="10"><Border WidthRequest="36" HeightRequest="40" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 12"><Image Source="brand_shield.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center" /></Border><Label Text="PassCrate" TextColor="White" FontFamily="OpenSansSemibold" FontSize="18" VerticalTextAlignment="Center" /></HorizontalStackLayout>
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16" MaximumWidthRequest="420" HorizontalOptions="Fill"><Border WidthRequest="128" HeightRequest="128" Stroke="#343F73" BackgroundColor="#111A39" StrokeShape="RoundRectangle 64" HorizontalOptions="Center"><Border WidthRequest="74" HeightRequest="82" StrokeThickness="0" BackgroundColor="#5B5CE2" StrokeShape="RoundRectangle 26" HorizontalOptions="Center" VerticalOptions="Center"><Image Source="brand_shield.png" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" VerticalOptions="Center" /></Border></Border><Label Text="Unlock PassCrate" TextColor="White" FontFamily="OpenSansSemibold" FontSize="30" HorizontalTextAlignment="Center" /><Label Text="Enter your vault passphrase to decrypt your secrets." TextColor="#94A3B8" FontSize="13" HorizontalTextAlignment="Center" /><Border Stroke="#2B3652" BackgroundColor="#121B2E" StrokeShape="RoundRectangle 15" Padding="12,0" Margin="0,12,0,0"><Entry Text="{Binding Passphrase}" Placeholder="Vault passphrase" PlaceholderColor="#64748B" TextColor="White" IsPassword="True" ReturnType="Go" ReturnCommand="{Binding UnlockCommand}" /></Border><Label Text="{Binding ErrorMessage}" TextColor="#F87171" HorizontalTextAlignment="Center" /><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Button Text="Unlock vault" Command="{Binding UnlockCommand}" IsEnabled="{Binding IsNotBusy}" /><Button Text="◎  Unlock with biometrics" Command="{Binding UnlockWithBiometricCommand}" IsVisible="{Binding IsBiometricAvailable}" Style="{StaticResource SecondaryButton}" TextColor="White" BackgroundColor="#121B2E" BorderColor="#2B3652" /></VerticalStackLayout>
        <Label Grid.Row="2" Text="PassCrate cannot recover a forgotten vault passphrase." TextColor="#64748B" FontSize="10" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
