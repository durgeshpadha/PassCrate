<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.UnlockPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24,36,24,24" RowDefinitions="Auto,*,Auto">
        <HorizontalStackLayout Spacing="10">
            <Border WidthRequest="38" HeightRequest="42" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 13">
                <Image Source="brand_shield.png" WidthRequest="33" HeightRequest="33" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="PassCrate" FontFamily="OpenSansSemibold" FontSize="19" VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="15"
                             MaximumWidthRequest="420"
                             HorizontalOptions="Fill">
            <Border Style="{StaticResource IconTile}"
                    WidthRequest="112"
                    HeightRequest="112"
                    StrokeShape="RoundRectangle 38"
                    HorizontalOptions="Center">
                <Border WidthRequest="68" HeightRequest="76" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 23" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="brand_shield.png" WidthRequest="59" HeightRequest="59" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Border>
            <Label Text="Welcome back" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
            <Label Text="Enter your vault passphrase to decrypt your secrets on this device."
                   Style="{StaticResource PageLead}"
                   HorizontalTextAlignment="Center" />
            <Border Style="{StaticResource FieldBorder}" Margin="0,10,0,0">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPassphraseInvalid}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Danger}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Text="{Binding Passphrase}"
                       Placeholder="Vault passphrase"
                       IsPassword="True"
                       ReturnType="Go"
                       ReturnCommand="{Binding UnlockCommand}" />
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Unlock vault" Command="{Binding UnlockCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="◎  Unlock with biometrics"
                    Command="{Binding UnlockWithBiometricCommand}"
                    IsVisible="{Binding IsBiometricAvailable}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Text="Forgot your passphrase?"
                    Command="{Binding ForgotPassphraseCommand}"
                    Style="{StaticResource TertiaryButton}" />
            <Label Text="Passphrases cannot be recovered. You can reset PassCrate and start again, but this device's saved vault will be permanently deleted."
                   Style="{StaticResource Muted}"
                   FontSize="10"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Label Grid.Row="2"
               Text="Your passphrase never leaves this device."
               Style="{StaticResource Muted}"
               FontSize="10"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
