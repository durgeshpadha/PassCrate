<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.RegistrationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="Create vault">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" MaximumWidthRequest="620">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                    <Label Text="✦" Style="{StaticResource AccentIcon}" FontSize="25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="PRIVATE BY DEFAULT" Style="{StaticResource AccentEyebrow}" />
                    <Label Text="Create your vault" Style="{StaticResource PageTitle}" FontSize="27" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Choose one memorable passphrase to protect your encrypted vault on this device and during optional cloud recovery."
                   Style="{StaticResource PageLead}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="VAULT PASSPHRASE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding Passphrase}" Placeholder="At least 16 characters" IsPassword="True" ReturnType="Next" />
                    </Border>
                    <Label Text="CONFIRM PASSPHRASE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConfirmPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding ConfirmPassphrase}" Placeholder="Enter it again" IsPassword="True" ReturnType="Done" />
                    </Border>
                    <Label Text="A short sentence that only you know is easier to remember and harder to guess."
                           Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource WarningCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="!" TextColor="{StaticResource Warning}" FontFamily="OpenSansSemibold" FontSize="22" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Your passphrase cannot be recovered" FontFamily="OpenSansSemibold" />
                        <Label Text="If you lose this passphrase, PassCrate cannot recover your secrets."
                               Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Padding="8,5" Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 12">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsRecoveryWarningInvalid}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Danger}" />
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDangerSurface}, Dark={StaticResource DarkDangerSurface}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding AcceptsRecoveryWarning}" VerticalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="I understand that my vault passphrase cannot be recovered."
                           Style="{StaticResource Muted}"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Create my vault" Command="{Binding CreateVaultCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Cancel" Style="{StaticResource TertiaryButton}" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
