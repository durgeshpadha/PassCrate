<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.SecretEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                    <Label Text="⌁" Style="{StaticResource AccentIcon}" FontSize="26" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="PRIVATE ITEM" Style="{StaticResource AccentEyebrow}" />
                    <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" FontSize="27" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="PassCrate protects all values and notes before saving them on this device."
                   Style="{StaticResource PageLead}" />
            <Label Text="SECRET NAME" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsNameInvalid}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Danger}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Text="{Binding Name}" Placeholder="e.g. GitHub account" ReturnType="Next" />
            </Border>
            <Label Text="GROUP" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsGroupInvalid}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Danger}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinimumHeightRequest="50">
                    <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" BackgroundColor="{Binding SelectedGroup.Color}" StrokeShape="RoundRectangle 12" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SelectedGroupName}" VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="⌄" Style="{StaticResource Muted}" FontSize="20" VerticalTextAlignment="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleGroupSelectorCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsGroupSelectorOpen}" Padding="8">
                <CollectionView ItemsSource="{Binding Groups}" SelectionMode="None" MaximumHeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectGroupCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" BackgroundColor="{Binding Color}" StrokeShape="RoundRectangle 12" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,9,0,0"><Label Text="Secret fields" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" /><Button Grid.Column="1" Text="＋ Add field" Command="{Binding AddFieldCommand}" Style="{StaticResource CompactButton}" /></Grid>
            <CollectionView ItemsSource="{Binding Fields}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Border Style="{StaticResource FieldBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsKeyInvalid}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry Text="{Binding Key}" Placeholder="Field name" />
                                </Border>
                                <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFieldCommand}" CommandParameter="{Binding .}" Style="{StaticResource CompactButton}" TextColor="{StaticResource Danger}" MinimumWidthRequest="44" />
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FieldBorder}"><Entry Text="{Binding Value}" Placeholder="Value" IsPassword="{Binding IsSensitive}" /></Border>
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8"><CheckBox IsChecked="{Binding IsSensitive}" /><Label Text="Hide this value by default" Style="{StaticResource Muted}" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="NOTES" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource FieldBorder}"><Editor Text="{Binding Notes}" Placeholder="Optional encrypted notes" AutoSize="TextChanges" /></Border>
            <Border Style="{StaticResource InfoCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="⌁" Style="{StaticResource AccentIcon}" /><Label Grid.Column="1" Text="Unprotected secret values are never saved on this device." Style="{StaticResource Muted}" VerticalTextAlignment="Center" /></Grid></Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save secret" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
