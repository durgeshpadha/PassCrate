<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.SecretEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,38" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            <Label Text="Sensitive field values and notes are encrypted together." Style="{StaticResource Muted}" />
            <Label Text="Secret name" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Name}" Placeholder="e.g. GitHub account" ReturnType="Next" /></Border>
            <Label Text="Group" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource FieldBorder}"><Picker ItemsSource="{Binding Groups}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedGroup}" Title="Choose a group" /></Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,9,0,0"><Label Text="Secret fields" Style="{StaticResource SectionTitle}" /><Button Grid.Column="1" Text="＋ Add field" Command="{Binding AddFieldCommand}" Style="{StaticResource SecondaryButton}" MinimumHeightRequest="42" Padding="12,7" /></Grid>
            <CollectionView ItemsSource="{Binding Fields}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Key}" Placeholder="Field name" /></Border>
                                <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFieldCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Danger}" MinimumWidthRequest="44" />
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FieldBorder}"><Entry Text="{Binding Value}" Placeholder="Value" IsPassword="{Binding IsSensitive}" /></Border>
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8"><CheckBox IsChecked="{Binding IsSensitive}" /><Label Text="Hide this value by default" Style="{StaticResource Muted}" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="Notes" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource FieldBorder}"><Editor Text="{Binding Notes}" Placeholder="Optional encrypted notes" AutoSize="TextChanges" /></Border>
            <Border Stroke="#B9C1F7" BackgroundColor="{AppThemeBinding Light=#F0F1FF, Dark=#1B2045}" StrokeShape="RoundRectangle 15" Padding="14"><HorizontalStackLayout Spacing="10"><Label Text="⌁" TextColor="{StaticResource Primary}" FontSize="20" /><Label Text="No plaintext secret values are written to local storage." Style="{StaticResource Muted}" VerticalTextAlignment="Center" /></HorizontalStackLayout></Border>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save encrypted secret" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
