<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.LegalDocumentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Legal information"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" Spacing="14">
            <VerticalStackLayout Spacing="5">
                <Label Text="PASSCRATE" Style="{StaticResource AccentEyebrow}" />
                <Label Text="{Binding Title}"
                       Style="{StaticResource PageTitle}"
                       FontSize="28"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Introduction}" Style="{StaticResource PageLead}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InfoCard}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Effective date" FontFamily="OpenSansSemibold" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="{Binding EffectiveDate}" HorizontalTextAlignment="End" />
                        <Label Text="{Binding Version, StringFormat='Version {0}'}"
                               Style="{StaticResource Muted}"
                               FontSize="11"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="{Binding Heading}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding Body}" Style="{StaticResource Muted}" LineHeight="1.3" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="This document is available offline and does not read or expose your vault."
                   Style="{StaticResource Muted}"
                   FontSize="11"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
