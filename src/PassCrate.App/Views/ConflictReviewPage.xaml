<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.ConflictReviewPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Conflict review">
    <Grid ColumnDefinitions="{OnIdiom Phone='*', Tablet='280,*'}" Padding="16" ColumnSpacing="14">
        <VerticalStackLayout Spacing="10">
            <Label Text="Conflicts" Style="{StaticResource SectionTitle}" />
            <CollectionView ItemsSource="{Binding ConflictSets}" EmptyView="Your vault has no unresolved conflicts.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding EntityKind}" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding RecordId}" LineBreakMode="MiddleTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        <ScrollView Grid.Column="{OnIdiom Phone=0, Tablet=1}">
            <VerticalStackLayout Spacing="12" Padding="{OnIdiom Phone='0,280,0,0', Tablet='0'}">
                <Label Text="Compare revisions" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding Revisions}" HeightRequest="120">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding DisplayName}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectRevisionCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Reveal sensitive values" VerticalTextAlignment="Center" />
                    <Switch IsToggled="{Binding ShowSensitiveValues}" />
                </HorizontalStackLayout>
                <Entry Text="{Binding MergedName}" Placeholder="Name" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Entry Text="{Binding MergedIcon}" Placeholder="Group icon" MaxLength="8" />
                    <Entry Grid.Column="1" Text="{Binding MergedColor}" Placeholder="Group color, for example #4F46E5" />
                </Grid>
                <CollectionView ItemsSource="{Binding MergedFields}" HeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                <Entry Text="{Binding Key}" Placeholder="Field" />
                                <Entry Grid.Column="1" Text="{Binding Value}" IsPassword="{Binding IsHidden}" Placeholder="Value" />
                                <Button Grid.Column="2" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFieldCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="Add field" Command="{Binding AddFieldCommand}" Style="{StaticResource SecondaryButton}" />
                <Editor Text="{Binding MergedNotes}" Placeholder="Merged notes" AutoSize="TextChanges" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button Text="Keep selected" Command="{Binding KeepSelectedCommand}" />
                    <Button Grid.Column="1" Text="Save manual merge" Command="{Binding SaveManualMergeCommand}" />
                    <Button Grid.Row="1" Text="Keep both" Command="{Binding KeepBothCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Accept deletion" Command="{Binding AcceptDeletionCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="Restore deleted group" Command="{Binding RestoreGroupCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Row="3" Grid.ColumnSpan="2" Text="Move secrets and delete group" Command="{Binding MoveAndDeleteGroupCommand}" Style="{StaticResource SecondaryButton}" />
                </Grid>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
