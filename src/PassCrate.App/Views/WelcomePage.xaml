<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,34,34"
                Padding="28,46,28,30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#171E4A" Offset="0" />
                    <GradientStop Color="#090E1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid RowDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Spacing="11" Margin="0,8,0,0">
                    <Border WidthRequest="40" HeightRequest="44" StrokeThickness="0" BackgroundColor="#6366E8" StrokeShape="RoundRectangle 14">
                        <Image Source="brand_shield.png" WidthRequest="35" HeightRequest="35" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="PassCrate" TextColor="White" FontFamily="OpenSansSemibold" FontSize="19" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Border Grid.Row="1"
                        WidthRequest="142"
                        HeightRequest="142"
                        Stroke="#394278"
                        BackgroundColor="#141B3C"
                        StrokeShape="RoundRectangle 46"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border WidthRequest="82"
                            HeightRequest="90"
                            StrokeThickness="0"
                            BackgroundColor="#5B5CE2"
                            StrokeShape="RoundRectangle 27"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Image Source="brand_shield.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Border>

                <VerticalStackLayout Grid.Row="2" Spacing="9">
                    <Label Text="Your private vault, beautifully simple."
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="29"
                           LineHeight="1.08" />
                    <Label Text="Secure passwords, keys, and private notes with encryption that stays under your control."
                           TextColor="#B5BED8"
                           FontSize="14"
                           LineHeight="1.25" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="24,22,24,28" Spacing="11">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,4">
                <Label Text="●  WORKS OFFLINE" TextColor="{StaticResource Success}" FontSize="9" CharacterSpacing="0.8" HorizontalTextAlignment="Center" />
                <Label Grid.Column="1" Text="NO TRACKING" Style="{StaticResource Eyebrow}" FontSize="9" HorizontalTextAlignment="Center" />
                <Label Grid.Column="2" Text="FULLY ENCRYPTED" Style="{StaticResource Eyebrow}" FontSize="9" HorizontalTextAlignment="Center" />
            </Grid>
            <Button Text="Create my vault  →" Command="{Binding CreateAccountCommand}" />
            <Button Text="Restore from cloud" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreFromCloudCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
