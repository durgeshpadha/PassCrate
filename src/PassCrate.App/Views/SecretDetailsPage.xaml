<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.SecretDetailsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Secret">
    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,34" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border WidthRequest="58" HeightRequest="58" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryLight}" StrokeShape="RoundRectangle 18"><Label Text="⌁" TextColor="{StaticResource Primary}" FontSize="30" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="ENCRYPTED SECRET" Style="{StaticResource Eyebrow}" /><Label Text="{Binding Name}" Style="{StaticResource PageTitle}" FontSize="24" /></VerticalStackLayout>
            </Grid>
            <Border Stroke="#8DE0C1" BackgroundColor="{AppThemeBinding Light=#EAFBF4, Dark=#102B26}" StrokeShape="RoundRectangle 15" Padding="14">
                <HorizontalStackLayout Spacing="10"><Label Text="●" TextColor="{StaticResource Success}" /><VerticalStackLayout><Label Text="Decrypted for this session" FontFamily="OpenSansSemibold" /><Label Text="Values are cleared from this page when you leave." Style="{StaticResource Muted}" /></VerticalStackLayout></HorizontalStackLayout>
            </Border>
            <CollectionView ItemsSource="{Binding Fields}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Key}" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Row="1" Text="{Binding DisplayValue}" FontFamily="OpenSansSemibold" FontSize="15" VerticalTextAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Show" IsVisible="{Binding IsSensitive}" Command="{Binding ToggleRevealCommand}" Style="{StaticResource SecondaryButton}" MinimumHeightRequest="38" Padding="11,6" />
                                <Button Grid.Row="1" Grid.Column="2" Text="Copy" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyFieldCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" MinimumHeightRequest="38" Padding="11,6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Style="{StaticResource Card}" IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}">
                <VerticalStackLayout Spacing="7"><Label Text="NOTES" Style="{StaticResource Eyebrow}" /><Label Text="{Binding Notes}" LineBreakMode="WordWrap" /></VerticalStackLayout>
            </Border>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Edit secret" Command="{Binding EditCommand}" />
                <Button Grid.Column="1" Text="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Danger}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
