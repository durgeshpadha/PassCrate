<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.SecretDetailsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="Secret">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource IconTile}" WidthRequest="58" HeightRequest="58" StrokeShape="RoundRectangle 18"><Label Text="⌁" Style="{StaticResource AccentIcon}" FontSize="30" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3"><Label Text="PRIVATE ITEM" Style="{StaticResource AccentEyebrow}" /><Label Text="{Binding Name}" Style="{StaticResource PageTitle}" FontSize="25" LineBreakMode="TailTruncation" /></VerticalStackLayout>
            </Grid>
            <Border Style="{StaticResource SuccessCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="●" TextColor="{StaticResource Success}" /><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Ready to view" FontFamily="OpenSansSemibold" /><Label Text="Values are hidden again when you leave this screen." Style="{StaticResource Muted}" /></VerticalStackLayout></Grid>
            </Border>
            <Label Text="FIELDS" Style="{StaticResource Eyebrow}" />
            <CollectionView ItemsSource="{Binding Fields}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <Label Text="{Binding Key}" Style="{StaticResource Eyebrow}" />
                                <Label Grid.Row="1" Text="{Binding DisplayValue}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="CharacterWrap" />
                                <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="End">
                                    <Button Text="Show" IsVisible="{Binding IsSensitive}" Command="{Binding ToggleRevealCommand}" Style="{StaticResource CompactButton}" />
                                    <Button Text="Copy" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyFieldCommand}" CommandParameter="{Binding .}" Style="{StaticResource CompactButton}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Style="{StaticResource Card}" IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="NOTES" Style="{StaticResource Eyebrow}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Copy notes" Command="{Binding CopyNotesCommand}" Style="{StaticResource CompactButton}" />
                    </Grid>
                    <Label Text="{Binding Notes}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource WarningCard}" IsVisible="{Binding HasUnresolvedConflict}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Different versions need your choice" FontFamily="OpenSansSemibold" />
                    <Label Text="To keep every version clear, edit and delete actions are paused until you review this secret's cloud conflict."
                           Style="{StaticResource Muted}" />
                    <Button Text="Review conflicting versions"
                            Command="{Binding ReviewConflictCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinimumHeightRequest="44" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <VerticalStackLayout IsVisible="{Binding ShowNormalActions}" Spacing="10">
                <Button Text="Edit secret" Command="{Binding EditCommand}" />
                <Button Text="Delete secret" Command="{Binding DeleteCommand}" Style="{StaticResource DangerOutlineButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
