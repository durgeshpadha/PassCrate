<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.GroupDetailsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Name}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Rename group"
                     Order="Secondary"
                     Priority="0"
                     Command="{Binding RenameCommand}" />
        <ToolbarItem Text="Delete group"
                     Order="Secondary"
                     Priority="1"
                     Command="{Binding DeleteCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20,18,20,24"
          RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Style="{StaticResource IconTile}"
                    WidthRequest="72"
                    HeightRequest="72"
                    StrokeShape="RoundRectangle 22">
                <Label Text="{Binding Icon}"
                       TextColor="{Binding Color}"
                       FontSize="32"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <Label Text="GROUP" Style="{StaticResource AccentEyebrow}" />
                <Label Text="{Binding Name}"
                       Style="{StaticResource PageTitle}"
                       FontSize="27"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding Secrets.Count, StringFormat='{0} encrypted secrets'}"
                       Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>

        <Button Grid.Row="1"
                Text="＋  Add secret"
                Command="{Binding AddSecretCommand}"
                HorizontalOptions="Fill"
                SemanticProperties.Hint="Creates a new encrypted secret in this group" />

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Label Text="Secrets" Style="{StaticResource SectionTitle}" />
            <Label Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Secrets}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,44"
                                         Spacing="8"
                                         HorizontalOptions="Center">
                        <Border Style="{StaticResource IconTile}"
                                WidthRequest="52"
                                HeightRequest="52"
                                StrokeShape="RoundRectangle 17">
                            <Label Text="⌁"
                                   Style="{StaticResource AccentIcon}"
                                   FontSize="25"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="No secrets in this group"
                               FontFamily="OpenSansSemibold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Add the first encrypted secret when you're ready."
                               Style="{StaticResource Muted}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenSecretCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                <Border Style="{StaticResource IconTile}"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeShape="RoundRectangle 14">
                                    <Label Text="⌁"
                                           Style="{StaticResource AccentIcon}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="Protected item" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="25"
                                       Style="{StaticResource Muted}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
