<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.ChangePasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Change passphrase">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}" MaximumWidthRequest="580">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                    <Label Text="✦" Style="{StaticResource AccentIcon}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="VAULT SECURITY" Style="{StaticResource AccentEyebrow}" />
                    <Label Text="Change passphrase" Style="{StaticResource PageTitle}" FontSize="27" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Your new passphrase will protect this device and future encrypted cloud recovery."
                   Style="{StaticResource PageLead}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CURRENT PASSPHRASE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCurrentPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding CurrentPassphrase}" Placeholder="Current passphrase" IsPassword="True" />
                    </Border>
                    <BoxView Style="{StaticResource Divider}" Margin="0,4" />
                    <Label Text="NEW PASSPHRASE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsNewPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding NewPassphrase}" IsPassword="True" Placeholder="At least 16 characters" />
                    </Border>
                    <Label Text="CONFIRM NEW PASSPHRASE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConfirmNewPassphraseInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry Text="{Binding ConfirmNewPassphrase}" Placeholder="Enter it again" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource InfoCard}">
                <Label Text="Your saved groups and secrets will stay the same. Only the passphrase used to unlock them will change."
                       Style="{StaticResource Muted}" />
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Change vault passphrase" Command="{Binding ChangeCommand}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
