<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PassCrate.App.Views.ChangePasswordPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Change vault passphrase">
    <ScrollView><VerticalStackLayout Padding="24,22,24,38" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Center">
        <Label Text="VAULT SECURITY" Style="{StaticResource Eyebrow}" /><Label Text="Change vault passphrase" Style="{StaticResource PageTitle}" /><Label Text="Your new passphrase protects this device and future cloud recovery." Style="{StaticResource Muted}" />
        <Label Text="Current passphrase" Style="{StaticResource Eyebrow}" Margin="0,14,0,0" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding CurrentPassphrase}" IsPassword="True" /></Border>
        <Label Text="New passphrase" Style="{StaticResource Eyebrow}" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding NewPassphrase}" IsPassword="True" Placeholder="At least 16 characters" /></Border>
        <Label Text="Confirm new passphrase" Style="{StaticResource Eyebrow}" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding ConfirmNewPassphrase}" IsPassword="True" /></Border>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" /><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Button Text="Change vault passphrase" Command="{Binding ChangeCommand}" IsEnabled="{Binding IsNotBusy}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
